{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thinking-house.local/contracts/math-island-export.schema.json",
  "title": "Douyin Math Island Export V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "sourceRevision", "world", "games", "assets", "contentDigest"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "sourceRevision": { "type": "string", "minLength": 1 },
    "world": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "summary", "gameCount", "roundCount"],
      "properties": {
        "id": { "const": "math" },
        "name": { "const": "数字岛" },
        "summary": { "type": "string", "minLength": 1 },
        "gameCount": { "const": 8 },
        "roundCount": { "const": 122 }
      }
    },
    "games": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/game" }
    },
    "assets": { "$ref": "#/$defs/assetManifest" },
    "contentDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "$defs": {
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "value"],
      "properties": { "label": { "type": "string" }, "value": { "type": "string" } }
    },
    "round": {
      "type": "object",
      "required": ["id", "level", "prompt", "instruction", "difficultyNote", "choices", "answer", "success", "retry", "parentPrompt", "abilityTags", "voice"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "level": { "enum": ["L1", "L2", "L3", "L4", "L5", "L6"] },
        "prompt": { "type": "string", "minLength": 1 },
        "instruction": { "type": "string", "minLength": 1 },
        "difficultyNote": { "type": "string", "minLength": 1 },
        "choices": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "$ref": "#/$defs/choice" } },
        "answer": { "type": "string" },
        "success": { "type": "string", "minLength": 1 },
        "retry": { "type": "string", "minLength": 1 },
        "parentPrompt": { "type": "string", "minLength": 1 },
        "abilityTags": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "voice": { "type": "object" }
      }
    },
    "game": {
      "type": "object",
      "required": ["id", "title", "subtitle", "goal", "parentPrompt", "abilityTags", "level", "rounds"],
      "properties": {
        "id": { "type": "string", "pattern": "^math-" },
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string", "minLength": 1 },
        "goal": { "type": "string", "minLength": 1 },
        "parentPrompt": { "type": "string", "minLength": 1 },
        "abilityTags": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "level": { "enum": ["L1", "L2", "L3", "L4", "L5", "L6"] },
        "rounds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/round" } }
      }
    },
    "assetManifest": {
      "type": "object",
      "required": ["version", "entries", "totalBytes"],
      "properties": {
        "version": { "const": 1 },
        "entries": { "type": "array" },
        "totalBytes": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
